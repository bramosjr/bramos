---
// AnalyticsDashboard.astro
import analytics from '../data/analytics.json';
---
<section id="analytics-section" class="scroll-mt-20" data-analytics={JSON.stringify(analytics)}>
  <div class="border-b border-borderSubtle pb-4 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <span class="text-xs font-semibold text-mintGreen uppercase tracking-widest">Telemetria Quantitativa</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-textPrimary mt-1">Dashboard Analítico de Produção</h2>
      </div>
      <span class="text-xs font-mono px-2.5 py-1 rounded bg-surface border border-borderSubtle text-textSecondary self-start sm:self-auto">
        Atualizado: {new Date(analytics.updatedAt).toLocaleDateString('pt-BR')}
      </span>
    </div>
    <p class="mt-2 text-sm text-textSecondary">
      Visualização gráfica com dados extraídos via GitHub GraphQL e paleta calibrada: Sage, Dourado, Bege, Argila, Coral e Menta.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Chart 1: Language Breakdown -->
    <div class="bg-surface p-5 rounded-2xl border border-borderSubtle flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-textPrimary text-base flex items-center gap-2">
          <span class="text-yellowAccent">📊</span> Distribuição de Linguagens
        </h3>
        <span class="text-[10px] uppercase font-mono px-2 py-0.5 bg-canvas border border-borderSubtle rounded text-textSecondary">Total: 100%</span>
      </div>
      <p class="text-xs text-textSecondary mb-4">Baseada no volume de código (bytes) em todos os {analytics.totalReposCount} repositórios.</p>
      <div class="relative w-full h-[280px] md:h-[320px] my-auto">
        <canvas id="languagesChart"></canvas>
      </div>
    </div>

    <!-- Chart 2: Commit Types Distribution -->
    <div class="bg-surface p-5 rounded-2xl border border-borderSubtle flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-textPrimary text-base flex items-center gap-2">
          <span class="text-sageGreen">🏷️</span> Tipos de Alterações (Conventional)
        </h3>
        <span class="text-[10px] uppercase font-mono px-2 py-0.5 bg-canvas border border-borderSubtle rounded text-textSecondary">Commits Reais</span>
      </div>
      <p class="text-xs text-textSecondary mb-4">Distribuição semântica dos commits analisados no pipeline.</p>
      <div class="relative w-full h-[280px] md:h-[320px] my-auto">
        <canvas id="commitTypesChart"></canvas>
      </div>
    </div>

    <!-- Chart 3: Weekly Activity Cadence (Full Width Bottom Row) -->
    <div class="lg:col-span-2 bg-surface p-6 rounded-2xl border border-borderSubtle flex flex-col">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <h3 class="font-bold text-textPrimary text-base flex items-center gap-2">
          <span class="text-mintGreen">📈</span> Cadência de Entregas Semanais
        </h3>
        <div class="flex items-center space-x-2">
          <label for="cadencePeriodFilter" class="text-xs text-textSecondary font-mono hidden sm:inline">Período:</label>
          <select id="cadencePeriodFilter" class="text-xs font-mono py-1.5 px-3 bg-canvas border border-borderSubtle rounded-lg text-textPrimary focus:border-mintGreen focus:outline-none transition cursor-pointer hover:border-mintGreen/50">
            <option value="4w">Últimas 4 Semanas</option>
            <option value="8w">Últimas 8 Semanas</option>
            <option value="12w">Últimos 3 Meses</option>
            <option value="all">Todo Período</option>
          </select>
        </div>
      </div>
      <p class="text-xs text-textSecondary mb-4">Volume de commits sanitizados distribuído ao longo do período selecionado.</p>
      <div class="relative w-full h-[260px] md:h-[300px]">
        <canvas id="activityCadenceChart"></canvas>
      </div>
    </div>
  </div>
</section>

<!-- Chart.js CDN -->
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline>
  let cadenceChartInstance = null;

  function initAnalyticsCharts() {
    if (typeof Chart === 'undefined') {
      setTimeout(initAnalyticsCharts, 100);
      return;
    }

    const sectionEl = document.getElementById('analytics-section');
    if (!sectionEl) return;

    let analyticsData;
    try {
      analyticsData = JSON.parse(sectionEl.dataset.analytics || '{}');
    } catch (e) {
      analyticsData = {};
    }

    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          labels: { color: '#9CB0A3', font: { size: 11 } }
        }
      }
    };

    const langLabels = analyticsData.languages?.labels || ['HTML', 'JavaScript', 'Rust', 'Shell', 'Outras'];
    const langData = analyticsData.languages?.percentages || [35, 30, 15, 10, 10];

    const typeLabels = analyticsData.commitTypes?.labels || ['feat', 'fix', 'refactor', 'infra', 'docs'];
    const typeData = analyticsData.commitTypes?.counts || [40, 20, 10, 5, 10];

    const cadencePeriods = analyticsData.cadencePeriods || {
      '4w': {
        labels: analyticsData.weeklyCadence?.labels || ['Semana 1', 'Semana 2', 'Semana 3', 'Semana 4'],
        counts: analyticsData.weeklyCadence?.counts || [5, 10, 15, 20]
      }
    };

    // Chart 1: Languages Breakdown (Doughnut) — sem bordas escuras
    const elLang = document.getElementById('languagesChart');
    if (elLang) {
      const ctxLang = elLang.getContext('2d');
      new Chart(ctxLang, {
        type: 'doughnut',
        data: {
          labels: langLabels,
          datasets: [{
            data: langData,
            backgroundColor: ['#8CAE99', '#EAB308', '#D4C5A9', '#C88A58', '#34D399'],
            borderWidth: 0,
            hoverOffset: 6
          }]
        },
        options: {
          ...commonOptions,
          plugins: {
            legend: { position: 'bottom', labels: { color: '#9CB0A3', font: { size: 10 } } }
          }
        }
      });
    }

    // Chart 2: Commit Types (Bar)
    const elTypes = document.getElementById('commitTypesChart');
    if (elTypes) {
      const ctxTypes = elTypes.getContext('2d');
      new Chart(ctxTypes, {
        type: 'bar',
        data: {
          labels: typeLabels,
          datasets: [{
            label: 'Volume de Commits',
            data: typeData,
            backgroundColor: ['#EAB308', '#E05D43', '#D4C5A9', '#C88A58', '#8CAE99'],
            borderRadius: 6
          }]
        },
        options: {
          ...commonOptions,
          scales: {
            x: { ticks: { color: '#9CB0A3' }, grid: { display: false } },
            y: { ticks: { color: '#9CB0A3' }, grid: { color: '#254E3E' } }
          }
        }
      });
    }

    // Chart 3: Weekly Activity Cadence (Line com filtro dinâmico e persistente)
    const elCadence = document.getElementById('activityCadenceChart');
    if (elCadence) {
      const ctxCadence = elCadence.getContext('2d');
      const periodSelect = document.getElementById('cadencePeriodFilter');

      // Recuperar período persistido no localStorage
      let savedPeriod = '4w';
      try {
        const stored = localStorage.getItem('gitactivity_cadence_period');
        if (stored && cadencePeriods[stored]) {
          savedPeriod = stored;
        }
      } catch (err) {}

      if (periodSelect) {
        periodSelect.value = savedPeriod;
      }

      const initialPeriod = cadencePeriods[savedPeriod] || cadencePeriods['4w'] || Object.values(cadencePeriods)[0];

      cadenceChartInstance = new Chart(ctxCadence, {
        type: 'line',
        data: {
          labels: initialPeriod.labels,
          datasets: [{
            label: 'Commits Sanitizados',
            data: initialPeriod.counts,
            borderColor: '#34D399',
            backgroundColor: 'rgba(52, 211, 153, 0.12)',
            fill: true,
            tension: 0.35,
            pointBackgroundColor: '#FACC15',
            pointRadius: 4
          }]
        },
        options: {
          ...commonOptions,
          scales: {
            x: {
              ticks: {
                color: '#9CB0A3',
                maxTicksLimit: 8,
                maxRotation: 0
              },
              grid: { color: '#254E3E' }
            },
            y: { ticks: { color: '#9CB0A3' }, grid: { color: '#254E3E' } }
          }
        }
      });

      // Listener para filtro de período com persistência
      periodSelect?.addEventListener('change', (e) => {
        const val = e.target.value;
        try {
          localStorage.setItem('gitactivity_cadence_period', val);
        } catch (err) {}
        const targetPeriod = cadencePeriods[val];
        if (targetPeriod && cadenceChartInstance) {
          cadenceChartInstance.data.labels = targetPeriod.labels;
          cadenceChartInstance.data.datasets[0].data = targetPeriod.counts;
          cadenceChartInstance.update();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnalyticsCharts);
  } else {
    initAnalyticsCharts();
  }
</script>
