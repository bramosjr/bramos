---
// Navbar.astro
import analytics from '../data/analytics.json';
import { GOATCOUNTER_TOTAL_URL } from '../config';
---
<header class="sticky top-0 z-50 bg-canvas/90 backdrop-blur-md border-b border-borderSubtle">
  <div class="w-full px-4 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-16">
      <a href={import.meta.env.BASE_URL} class="flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-lg bg-surface border border-borderSubtle flex items-center justify-center p-1.5 shadow-lg shadow-success/10 group-hover:border-accent/40 transition">
          <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <span class="font-bold text-lg text-textPrimary tracking-tight group-hover:text-accent transition">GitActivity<span class="text-accent">News</span></span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex space-x-1 lg:space-x-2 text-sm font-medium">
        <a href="#feed-section" class="px-3 py-2 rounded-md hover:bg-surface text-textPrimary hover:text-accent transition">Feed</a>
        <a href="#public-repos" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Projetos Públicos</a>
        <a href="#analytics-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Analytics</a>
      </nav>

      <!-- Quick Status Widget -->
      <div class="flex items-center space-x-2">
        <!-- Contador de visitantes: nasce oculto e só aparece se o GoatCounter responder -->
        <div
          id="visitor-counter"
          data-endpoint={GOATCOUNTER_TOTAL_URL}
          class="hidden items-center space-x-2 px-3 py-1.5 rounded-full bg-surface border border-borderSubtle text-xs"
          title="Visitas totais e visitantes únicos (contagem anônima, sem cookies)"
        >
          <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span class="text-accent font-semibold font-mono" data-visitor-total></span>
          <span class="text-textSecondary font-mono hidden sm:inline">visitas</span>
          <span class="text-textSecondary font-mono hidden lg:inline">· <span data-visitor-unique></span> únicos</span>
        </div>
        <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-surface border border-borderSubtle text-xs">
          <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
          <span class="text-textSecondary font-mono hidden sm:inline">CI/CD: Ativo</span>
          <span class="text-accent font-semibold font-mono">{analytics.privateReposCount} Privados</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Lê o total público do GoatCounter e revela o selo. Falha silenciosa: se algo der errado, o selo continua oculto.
  const SAFE_NUMBER = /^[0-9\s.,  ]{1,15}$/;

  async function carregarContador(): Promise<void> {
    const el = document.getElementById('visitor-counter');
    const endpoint = el?.dataset.endpoint;
    if (!el || !endpoint) return;

    try {
      const resp = await fetch(endpoint, { headers: { Accept: 'application/json' } });
      if (!resp.ok) return;

      const dados: { count?: unknown; count_unique?: unknown } = await resp.json();
      const total = String(dados.count ?? '');
      const unicos = String(dados.count_unique ?? '');
      if (!SAFE_NUMBER.test(total) || !SAFE_NUMBER.test(unicos)) return;

      const totalEl = el.querySelector('[data-visitor-total]');
      const unicoEl = el.querySelector('[data-visitor-unique]');
      if (!totalEl || !unicoEl) return;

      // textContent (nunca innerHTML): o valor vem de serviço externo.
      totalEl.textContent = total;
      unicoEl.textContent = unicos;
      el.classList.remove('hidden');
      el.classList.add('flex');
    } catch {
      // Serviço indisponível ou bloqueado (ex.: adblock): mantém o selo oculto.
    }
  }

  carregarContador();
</script>
