---
// Navbar.astro
import analytics from '../data/analytics.json';

const isDocs = Astro.url.pathname.startsWith(`${import.meta.env.BASE_URL}docs`);
---
<header class="sticky top-0 z-50 bg-canvas/90 backdrop-blur-md border-b border-borderSubtle">
  <div class="w-full px-4 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-16">
      <a href={import.meta.env.BASE_URL} class="flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-lg bg-surface border border-borderSubtle flex items-center justify-center p-1.5 shadow-lg shadow-success/10 group-hover:border-accent/40 transition">
          <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <span class="font-bold text-lg text-textPrimary tracking-tight group-hover:text-accent transition">GitActivity<span class="text-accent">News</span></span>
        </div>
      </a>

      {!isDocs && (
        <>
          <!-- Navigation Links -->
          <nav class="hidden md:flex space-x-1 lg:space-x-2 text-sm font-medium">
            <a href="#feed-section" class="px-3 py-2 rounded-md hover:bg-surface text-textPrimary hover:text-accent transition">Feed</a>
            <a href="#public-repos" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Projetos Públicos</a>
            <a href="#analytics-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Analytics</a>
            <a href="#architecture-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Arquitetura SSG</a>
            <a href="#security-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Segurança</a>
            <a href="#design-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Design System</a>
            <a href="#ai-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-success transition">Recursos IA</a>
            <a href={`${import.meta.env.BASE_URL}docs`} class="px-3 py-2 rounded-md bg-accent/10 border border-accent/30 text-accent hover:bg-accent/20 transition">Docs</a>
          </nav>

          <!-- Quick Status Widget -->
          <div class="flex items-center space-x-2">
            <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-surface border border-borderSubtle text-xs">
              <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
              <span class="text-textSecondary font-mono hidden sm:inline">CI/CD: Ativo</span>
              <span class="text-accent font-semibold font-mono">{analytics.privateReposCount} Privados</span>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</header>
