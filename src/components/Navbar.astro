---
// Navbar.astro
import analytics from '../data/analytics.json';

const isDocs = Astro.url.pathname.startsWith('/docs');
---
<header class="sticky top-0 z-50 bg-canvas/90 backdrop-blur-md border-b border-borderSubtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-lg bg-surface border border-borderSubtle flex items-center justify-center p-1.5 shadow-lg shadow-mintGreen/10 group-hover:border-yellowAccent/40 transition">
          <img src="/logo.png" alt="Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <span class="font-bold text-lg text-textPrimary tracking-tight group-hover:text-yellowAccent transition">GitActivity<span class="text-yellowAccent">News</span></span>
        </div>
      </a>

      {!isDocs && (
        <>
          <!-- Navigation Links -->
          <nav class="hidden md:flex space-x-1 lg:space-x-2 text-sm font-medium">
            <a href="#feed-section" class="px-3 py-2 rounded-md hover:bg-surface text-textPrimary hover:text-yellowAccent transition">Feed</a>
            <a href="#public-repos" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-mintGreen transition">Projetos Públicos</a>
            <a href="#analytics-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-mintGreen transition">Analytics</a>
            <a href="#architecture-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-mintGreen transition">Arquitetura SSG</a>
            <a href="#security-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-mintGreen transition">Segurança</a>
            <a href="#design-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-mintGreen transition">Design System</a>
            <a href="#ai-section" class="px-3 py-2 rounded-md hover:bg-surface text-textSecondary hover:text-mintGreen transition">Recursos IA</a>
            <a href="/docs" class="px-3 py-2 rounded-md bg-yellowAccent/10 border border-yellowAccent/30 text-yellowAccent hover:bg-yellowAccent/20 transition">Docs</a>
          </nav>

          <!-- Quick Status Widget -->
          <div class="flex items-center space-x-2">
            <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-surface border border-borderSubtle text-xs">
              <span class="w-2 h-2 rounded-full bg-mintGreen animate-pulse"></span>
              <span class="text-textSecondary font-mono hidden sm:inline">CI/CD: Ativo</span>
              <span class="text-yellowAccent font-semibold font-mono">{analytics.privateReposCount} Privados</span>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</header>
