---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeedTimeline from '../components/FeedTimeline.astro';
import PublicRepos from '../components/PublicRepos.astro';
import AnalyticsDashboard from '../components/AnalyticsDashboard.astro';
import SsgComparison from '../components/SsgComparison.astro';
import SecurityMatrix from '../components/SecurityMatrix.astro';
import DesignSystem from '../components/DesignSystem.astro';
import AiSummary from '../components/AiSummary.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Jorge Ramos Jr (@bramosjr) — Portfólio de Engenharia & Telemetria GitHub">
  <Navbar />
  <Hero />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16">
    <FeedTimeline />
    <PublicRepos />
    <AnalyticsDashboard />
    <SsgComparison />
    <SecurityMatrix />
    <DesignSystem />
    <AiSummary />
  </main>
  <Footer />
</Layout>
