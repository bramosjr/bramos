---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Portal de Atividades GitHub & Guia Arquitetural", 
	description = "Centralize a telemetria da sua conta do GitHub sem vazar segredos ou códigos confidenciais sob NDA." 
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
		<link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-canvas text-textPrimary font-sans antialiased min-h-screen flex flex-col selection:bg-accent selection:text-canvas">
		<slot />
	</body>
</html>

<style is:global>
	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: #37211B;
	}
	::-webkit-scrollbar-thumb {
		background: #4A332B;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #34D399;
	}
</style>
