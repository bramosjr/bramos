---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { frontmatter, headings } = Astro.props;
---

<Layout title={`${frontmatter.title} - Documentação`} description={frontmatter.description}>
	<Navbar />

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
			<aside class="lg:col-span-3">
				<div class="sticky top-24 bg-surface p-5 rounded-2xl border border-borderSubtle">
					<h4 class="text-xs font-mono uppercase text-yellowAccent tracking-wider mb-4 font-bold">Sumário</h4>
					<ul class="space-y-2 text-xs">
						{headings && headings.map((h: { depth: number; slug: string; text: string }) => (
							<li class={h.depth === 3 ? "pl-3 text-textSecondary" : "font-medium text-textPrimary"}>
								<a href={`#${h.slug}`} class="hover:text-yellowAccent transition-colors block py-0.5">
									{h.text}
								</a>
							</li>
						))}
					</ul>
				</div>
			</aside>
			
			<main class="lg:col-span-9 bg-surface p-6 sm:p-10 rounded-2xl border border-borderSubtle">
				<header class="mb-6 pb-6 border-b border-borderSubtle">
					<span class="text-xs font-mono uppercase text-sageGreen tracking-wider font-bold">Documentação Técnica</span>
					<h1 class="text-3xl sm:text-4xl font-extrabold text-textPrimary mt-2 mb-3">{frontmatter.title}</h1>
					{frontmatter.description && <p class="text-textSecondary text-sm sm:text-base leading-relaxed">{frontmatter.description}</p>}
				</header>
				
				<div class="doc-content prose prose-invert max-w-none text-textSecondary text-sm leading-relaxed space-y-4">
					<slot />
				</div>
			</main>
		</div>
	</div>

	<Footer />
</Layout>

<style is:global>
	.doc-content h2 {
		font-size: 1.5rem;
		font-weight: 700;
		color: #F7F4EA;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid #254E3E;
		padding-bottom: 0.5rem;
	}
	.doc-content h3 {
		font-size: 1.25rem;
		font-weight: 600;
		color: #FACC15;
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.doc-content p {
		margin-bottom: 1rem;
		color: #9CB0A3;
	}
	.doc-content ul, .doc-content ol {
		margin-bottom: 1rem;
		padding-left: 1.5rem;
	}
	.doc-content li {
		margin-bottom: 0.35rem;
	}
	.doc-content code {
		background: #091A13;
		color: #8CAE99;
		padding: 0.2rem 0.4rem;
		border-radius: 0.25rem;
		font-family: monospace;
		font-size: 0.875em;
		border: 1px solid #254E3E;
	}
	.doc-content pre {
		background: #091A13;
		border: 1px solid #254E3E;
		padding: 1rem;
		border-radius: 0.75rem;
		overflow-x: auto;
		margin-bottom: 1.25rem;
	}
	.doc-content pre code {
		background: transparent;
		border: none;
		padding: 0;
		color: #F7F4EA;
	}
</style>
