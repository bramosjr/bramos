---
import Layout from './Layout.astro';
const { frontmatter, headings } = Astro.props;
---

<Layout title={`${frontmatter.title} - Documentação`} description={frontmatter.description}>
	<nav class="navbar">
		<div class="container nav-content">
			<a href="/" class="logo">Logo<span>.</span></a>
			<div class="nav-links">
				<a href="/">Home</a>
				<a href="/docs">Documentação</a>
				<a href="/#contato" class="btn btn-primary btn-sm">Suporte</a>
			</div>
		</div>
	</nav>

	<div class="container doc-layout">
		<aside class="sidebar">
			<nav>
				<h4>Sumário</h4>
				<ul>
					{headings.map((h) => (
						<li class={`depth-${h.depth}`}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
		
		<main class="content">
			<header class="doc-header">
				<h1>{frontmatter.title}</h1>
				{frontmatter.description && <p class="lead">{frontmatter.description}</p>}
			</header>
			<hr />
			<div class="prose">
				<slot />
			</div>
		</main>
	</div>
</Layout>

<style>
	.navbar {
		height: 4.5rem;
		display: flex;
		align-items: center;
		background: white;
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.nav-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.logo {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-main);
	}
	.logo span {
		color: var(--primary);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	.nav-links a:not(.btn) {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--text-muted);
	}

	.doc-layout {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: 4rem;
		padding-top: 3rem;
		padding-bottom: 5rem;
	}

	.sidebar {
		position: sticky;
		top: 7.5rem;
		height: fit-content;
	}

	.sidebar h4 {
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
		color: var(--secondary);
	}

	.sidebar ul {
		list-style: none;
	}

	.sidebar li {
		margin-bottom: 0.5rem;
	}

	.sidebar a {
		font-size: 0.9375rem;
		color: var(--text-muted);
	}

	.sidebar .depth-3 {
		padding-left: 1rem;
		font-size: 0.875rem;
	}

	.doc-header h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.lead {
		font-size: 1.25rem;
		margin-bottom: 2rem;
	}

	hr {
		border: 0;
		border-top: 1px solid var(--border);
		margin: 2rem 0;
	}

	/* Prose/Markdown Styles */
	.prose :global(h2) {
		font-size: 1.875rem;
		margin: 2.5rem 0 1rem;
	}
	.prose :global(h3) {
		font-size: 1.5rem;
		margin: 2rem 0 1rem;
	}
	.prose :global(p) {
		margin-bottom: 1.25rem;
		line-height: 1.7;
	}
	.prose :global(ul), .prose :global(ol) {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
	}
	.prose :global(li) {
		margin-bottom: 0.5rem;
	}
	.prose :global(code) {
		background: var(--bg-alt);
		padding: 0.2rem 0.4rem;
		border-radius: 0.25rem;
		font-size: 0.9em;
	}
	.prose :global(pre) {
		background: #1e293b;
		color: white;
		padding: 1.5rem;
		border-radius: 0.75rem;
		margin-bottom: 1.5rem;
		overflow-x: auto;
	}

	@media (max-width: 768px) {
		.doc-layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.sidebar {
			display: none;
		}
	}
</style>
